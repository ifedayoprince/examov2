{
	"name": "examov2",
	"version": "0.0.0",
	"license": "MIT",
	"main": "dist/cli.js",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@ai-sdk/openai": "^3.0.30",
		"@inkjs/ui": "^2.0.0",
		"@types/react-dom": "^19.2.3",
		"ai": "^6.0.97",
		"dotenv": "^17.3.1",
		"fs-extra": "^11.3.3",
		"ink": "^6.8.0",
		"meow": "^11.0.0",
		"node-pandoc": "^0.3.0",
		"p-limit": "^7.3.0",
		"pdf2pic": "^3.2.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"sharp": "^0.34.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^3.0.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.3.0",
		"@types/react": "^19.2.14",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"eslint-config-xo-react": "^0.27.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^2.8.7",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3",
		"xo": "^0.53.1"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config"
}
